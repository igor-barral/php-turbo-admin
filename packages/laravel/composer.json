{
    "name": "php-turbo/admin-laravel",
    "description": "Adapter Laravel do php-turbo-admin: painel admin gerado a partir dos models Eloquent.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "admin", "panel", "crud", "eloquent", "headless"],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "php-turbo/admin-core": "@dev"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "PhpTurbo\\Admin\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpTurbo\\Admin\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PhpTurbo\\Admin\\Laravel\\AdminServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=95",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
